{
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 256
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/subscribe", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "0 * * * *"
    }
  ]
}
